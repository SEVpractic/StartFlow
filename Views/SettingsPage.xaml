<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StartFlow.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <ScrollViewer>
            <StackPanel
                Padding="40,32,40,48"
                Spacing="16"
                MaxWidth="940"
                HorizontalAlignment="Center">

                <StackPanel Spacing="4">
                    <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Конфигурация рабочего окружения"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Opacity="0.7" />
                </StackPanel>

                <InfoBar
                    Severity="Warning"
                    Title="Внимание"
                    Message="{Binding LoadWarning}"
                    IsOpen="{Binding HasLoadWarning, Mode=OneWay}"
                    IsClosable="False" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Генерация папки" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock
                            Text="Записи создают новую папку с подстановками. Поддерживается подстановка {date} — текущая дата в формате дд.ММ.гггг."
                            FontSize="12"
                            Style="{StaticResource SecondaryTextStyle}" />

                        <ItemsControl ItemsSource="{Binding FolderGeneration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="8" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Header="Путь"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Content="Выбрать"
                                                Command="{Binding ChoosePathCommand}"
                                                VerticalAlignment="Bottom" />

                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Header="Шаблон имени"
                                                PlaceholderText="Homework {date}"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <ToggleSwitch
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Header="Создавать папку при запуске"
                                                IsOn="{Binding Enabled, Mode=TwoWay}" />

                                            <ToggleSwitch
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Header="Открыть после создания"
                                                IsOn="{Binding OpenAfterCreate, Mode=TwoWay}" />

                                            <Button
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Content="Удалить"
                                                Command="{Binding DeleteCommand}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Добавить генерацию" Command="{Binding AddFolderGenerationCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Папки для открытия" Style="{StaticResource SectionTitleStyle}" />

                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    Header="Путь"
                                                    IsSpellCheckEnabled="False"
                                                    Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="Выбрать"
                                                    Command="{Binding ChoosePathCommand}"
                                                    VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch
                                                    Grid.Column="0"
                                                    Header="Открывать при запуске"
                                                    IsOn="{Binding Enabled, Mode=TwoWay}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="Удалить"
                                                    Command="{Binding DeleteCommand}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Добавить папку" Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Приложения" Style="{StaticResource SectionTitleStyle}" />

                        <ItemsControl ItemsSource="{Binding Programs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="10">
                                            <TextBox
                                                Header="Название"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    Header="Путь"
                                                    IsSpellCheckEnabled="False"
                                                    Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="Выбрать"
                                                    Command="{Binding ChooseExeCommand}"
                                                    VerticalAlignment="Bottom" />
                                            </Grid>

                                            <TextBox
                                                Header="Аргументы"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding Args, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox
                                                Content="Запускать от имени администратора"
                                                IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" />

                                            <CheckBox
                                                Content="Не запускать, если уже работает"
                                                IsChecked="{Binding SkipIfRunning, Mode=TwoWay}" />

                                            <TextBox
                                                Header="Имя процесса"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    Content="Включено"
                                                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="Удалить"
                                                    Command="{Binding DeleteCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Добавить приложение" Command="{Binding AddProgramCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Тема" Style="{StaticResource SectionTitleStyle}" />

                        <ComboBox
                            Header="Внешний вид"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Системная" />
                            <ComboBoxItem Content="Светлая" />
                            <ComboBoxItem Content="Тёмная" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>