<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StartFlow.Views.InstalledAppsPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            Grid.Row="0"
            Header="Поиск"
            PlaceholderText="Поиск приложений..."
            IsSpellCheckEnabled="False"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Поиск приложения" />

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <ListView
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Single"
                MaxHeight="380"
                HorizontalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="{Binding Icon}"
                                Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}" />
                            <FontIcon
                                Glyph="&#xE9D5;"
                                FontSize="18"
                                VerticalAlignment="Center"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="320" />
                                <TextBlock
                                    Text="{Binding RestrictionReason}"
                                    FontSize="11"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Visibility="{Binding RestrictionReason, Converter={StaticResource NotNullToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="{Binding IsLoading}" Width="36" Height="36" />
                <TextBlock
                    Text="Получение списка приложений..."
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Ничего не найдено"
                Style="{StaticResource SecondaryTextStyle}"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Text="Приложения Store (UWP/MSIX) отображаются без возможности выбора — они запускаются только через Windows и не имеют пути к exe. Для них используйте вариант «Найти exe вручную»."
            FontSize="11"
            TextWrapping="Wrap"
            MaxWidth="440"
            Style="{StaticResource SecondaryTextStyle}" />
    </Grid>
</UserControl>